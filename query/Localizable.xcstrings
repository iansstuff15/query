    "Couldn't move saved passwords, so the store wasn't changed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron mover las contraseñas guardadas, así que el almacén no ha cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déplacer les mots de passe enregistrés ; le stockage n’a donc pas été modifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherten Passwörter konnten nicht verschoben werden, daher wurde der Speicher nicht geändert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたパスワードを移動できなかったため、保存場所は変更されませんでした。"
          }
        }
      }
    },
    "Couldn't open that file. It may be too large or not text.": {
