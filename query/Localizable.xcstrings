    "The file is encrypted with AES-256 using a key derived from your passphrase (8+ characters). It can't be recovered without it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo se cifra con AES-256 usando una clave derivada de tu frase de contraseña (8 caracteres o más). No se puede recuperar sin ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est chiffré en AES-256 avec une clé dérivée de votre phrase secrète (8 caractères ou plus). Il est irrécupérable sans elle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wird mit AES-256 und einem aus deiner Passphrase (mindestens 8 Zeichen) abgeleiteten Schlüssel verschlüsselt. Ohne sie lässt sie sich nicht wiederherstellen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは、パスフレーズ（8文字以上）から生成した鍵でAES-256暗号化されます。パスフレーズがないと復元できません。"
          }
        }
      }
    },
