    "Choose how query looks and where it keeps your passwords.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el aspecto de query y dónde guarda tus contraseñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l’apparence de query et l’endroit où il conserve vos mots de passe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege fest, wie query aussieht und wo es deine Passwörter speichert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "queryの外観とパスワードの保存場所を選択します。"
          }
        }
      }
    },
    "Choose the language query uses. It applies right away and can be changed in Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el idioma de query. Se aplica al instante y puedes cambiarlo en Ajustes."
